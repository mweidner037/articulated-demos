{
  "name": "folder-tree",
  "version": "0.1.0",
  "description": "Collaborative folder tree demo",
  "license": "MIT",
  "dependencies": {
    "articulated": "^1.3.1",
    "express": "^5.2.1",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "scripts": {
    "dev": "npm-run-all dev:*",
    "dev:client": "vite build --mode development",
    "dev:server": "tsx --tsconfig tsconfig.server.json src/server/server.ts",
    "build": "npm-run-all build:*",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/server.js",
    "test": "npm-run-all test:*",
    "test:format": "prettier --check .",
    "fix": "npm-run-all fix:*",
    "fix:format": "prettier --write ."
  }
}
